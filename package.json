{
  "name": "tierflow-desktop",
  "version": "0.4.10",
  "private": true,
  "description": "TierFlow · Personal intelligent API router",
  "author": "TierFlow",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/brand-icons.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --win --dir",
    "check": "npm run build && npm test",
    "installer": "npm run build && electron-builder --win nsis --x64 --publish never && node scripts/installer-artifacts.mjs",
    "mac:test": "npm run build && node scripts/package-mac-test.mjs",
    "mac:dmg": "npm run check && node scripts/package-mac-native.mjs"
  },
  "build": {
    "appId": "cn.tierflow.desktop",
    "productName": "TierFlow",
    "directories": {
      "output": "release/0.4.10"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "icon": "public/icon.ico"
    },
    "afterPack": "scripts/brand-executable.cjs",
    "nsis": {
      "artifactName": "TierFlow-Setup-${version}.exe",
      "script": "build/installer.nsi",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "packElevateHelper": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "plist": "3.1.0",
    "rcedit": "5.0.2",
    "typescript": "7.0.2",
    "unzipper": "0.12.5",
    "vite": "8.3.3",
    "yazl": "3.3.1"
  }
}
